# LLM Configuration (DashScope / 阿里云通义千问)
DASHSCOPE_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=false

# Game
GAME_MAX_ROUNDS=8
BOOTSTRAP_SAMPLES=50
EQUILIBRIUM_MAX_ITER=20

# Qdrant
QDRANT_URL=data/qdrant_storage/
QDRANT_MEMORY=false
