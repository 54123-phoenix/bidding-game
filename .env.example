# Application Environment
APP_ENV=dev

# LLM Provider (DashScope / Alibaba Cloud)
DASHSCOPE_API_KEY=your_api_key_here
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_FALLBACK_MODEL=qwen-turbo

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEBUG=false

# Qdrant Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_MEMORY=true

# Redis Session Store
# For local dev without Redis, leave empty to fall back to in-memory
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
SESSION_TTL=14400

# Game Parameters
GAME_MAX_ROUNDS=8
BOOTSTRAP_SAMPLES=50
EQUILIBRIUM_MAX_ITER=20
